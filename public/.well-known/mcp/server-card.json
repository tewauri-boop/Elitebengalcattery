{
  "$schema": "https://modelcontextprotocol.io/schemas/server-card/v1.json",
  "serverInfo": {
    "name": "Elite Bengal Cattery",
    "version": "1.0.0",
    "description": "Ethically Bred Purebred Bengal Kittens with Exceptional Rosettes and Wild Elegance",
    "homepage": "https://DOMAIN.com",
    "contact": {
      "email": "elitebengalcattery28@gmail.com",
      "whatsapp": "+1 720 310 0222"
    }
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://DOMAIN.com/api/mcp"
  },
  "capabilities": {
    "tools": [
      {
        "name": "search_products",
        "description": "Search available Bengal kittens by keyword, category, max_price",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "max_price": {
              "type": "number"
            }
          }
        }
      },
      {
        "name": "get_product",
        "description": "Get full kitten details by slug",
        "inputSchema": {
          "type": "object",
          "required": [
            "slug"
          ],
          "properties": {
            "slug": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "list_categories",
        "description": "List all Bengal kitten categories",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "get_policies",
        "description": "Get delivery, deposit, health guarantee, payment policies",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "create_order_draft",
        "description": "Create prefilled adoption draft URL. Human completes — never captures payment.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    ],
    "resources": [
      {
        "name": "product-catalog",
        "description": "Full kitten catalog",
        "uri": "https://DOMAIN.com/shop/"
      },
      {
        "name": "wholesale",
        "description": "Breeding rights",
        "uri": "https://DOMAIN.com/wholesale/"
      },
      {
        "name": "blog",
        "description": "Educational content",
        "uri": "https://DOMAIN.com/blog/"
      }
    ],
    "commerce": {
      "ordering": "human-assisted-whatsapp-or-form",
      "payment": [
        "Zelle",
        "Cash App",
        "PayPal",
        "Chime",
        "crypto-BTC",
        "crypto-USDT",
        "Bank Wire Transfer",
        "Certified Gift Cards"
      ],
      "currency": "USD",
      "minimumOrder": "0",
      "freeShipping": "Free White-Glove Pet Courier Delivery"
    }
  },
  "legal": {
    "ageRestriction": "none",
    "productType": "Purebred Bengal Kittens",
    "compliance": "TICA Registered Ethical Cattery"
  }
}